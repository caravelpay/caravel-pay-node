{
  "name": "caravel-pay",
  "version": "1.2.2",
  "description": "Caravel Pay Node.js SDK: hosted card and crypto checkouts that pay out in USDC on Polygon, signed requests and webhook verification.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "files": ["src/", "index.d.ts", "README.md", "LICENSE", "CHANGELOG.md"],
  "sideEffects": false,
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc -p tests/tsconfig.json"
  },
  "keywords": ["caravel pay", "payments", "checkout", "usdc", "polygon", "webhooks", "payment gateway"],
  "homepage": "https://caravelpay.app/docs/node-sdk.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caravelpay/caravel-pay-node.git"
  },
  "bugs": {
    "email": "hello@caravelpay.app"
  }
}
